[Unit]
Description=grove forge off-VM backup (grove-syncd + Forgejo to GCS)
Documentation=https://github.com/grovetools/sync/blob/main/docs/runbooks/gcs-backup.md
After=network-online.target grove-syncd.service forgejo.service
Wants=network-online.target

[Service]
Type=oneshot
# Root, and a SEPARATE unit from the services it backs up rather than a hook
# inside them. grove-syncd runs with DynamicUser=yes, so its StateDirectory is
# /var/lib/private/grove-syncd — a path only root can traverse. Forgejo's data
# dir is its own user's. One privileged reader beats two sandbox escapes.
ExecStart=/usr/local/bin/grove-forge-backup.sh
EnvironmentFile=-/etc/grove-forge/backup.env
# gcloud REQUIRES a writable config dir and refuses to run without one; under
# ProtectSystem=strict + ProtectHome=yes it resolves $HOME/.config, finds
# /root/.config read-only, and crashes with CommandLoadFailure before it makes
# a single API call. PrivateTmp gives this unit its own /tmp, so pointing both
# variables there keeps the sandbox intact instead of loosening it.
Environment=HOME=/tmp
Environment=CLOUDSDK_CONFIG=/tmp/gcloud

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/grove-forge /tmp
# VACUUM INTO and the repo tar need only read access to live service state.
ReadOnlyPaths=/var/lib/private /var/lib/forgejo
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
