[Unit]
Description=Check that the grove forge backup is not stale
Documentation=https://github.com/grovetools/sync/blob/main/docs/runbooks/gcs-backup.md

[Timer]
# Deliberately more frequent than the backup itself: the point is to notice a
# missed window promptly, not to notice it one window later.
OnCalendar=*-*-* 03,15:00:00
Persistent=true
Unit=grove-forge-backup-check.service

[Install]
WantedBy=timers.target
