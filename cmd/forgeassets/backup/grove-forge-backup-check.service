[Unit]
Description=grove forge backup staleness check (alerts when backups stop happening)
Documentation=https://github.com/grovetools/sync/blob/main/docs/runbooks/gcs-backup.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/grove-forge-backup-check.sh
EnvironmentFile=-/etc/grove-forge/backup.env
# gcloud REQUIRES a writable config dir and refuses to run without one; under
# ProtectSystem=strict + ProtectHome=yes it resolves $HOME/.config, finds
# /root/.config read-only, and crashes with CommandLoadFailure before it makes
# a single API call. PrivateTmp gives this unit its own /tmp, so pointing both
# variables there keeps the sandbox intact instead of loosening it.
Environment=HOME=/tmp
Environment=CLOUDSDK_CONFIG=/tmp/gcloud
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
